git_c() {
  local url="$1"
  [[ "$url" =~ ^[^:]+/.+$ ]] && url="git@github.com:${url}.git"
  local shallow=()
  [[ "${FUNCNAME[1]}" == "git_cs" ]] && shallow=(--depth 1 --single-branch)
  local dir="${url##*/}"
  dir="${dir%.git}"
  [[ -n "$2" && "$2" != -* ]] && dir="$2"
  command git clone "${shallow[@]}" "$url" "${@:2}" && cd "$dir"
}

git_cs() { git_c "$@"; }

git_changelog() {
  local base="${1:?usage: git changelog <base> <head>}"
  local head="${2:?usage: git changelog <base> <head>}"
  local jq_filter='.commits[:-1][] | [(.sha[:9]), (.commit.message | split("\n")[0]), .author.login] | @tsv'
  local repo my_login commits me
  repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)"
  my_login="$(gh api user -q .login 2>/dev/null)"

  if [ -n "$repo" ] && [ -n "$my_login" ] && commits="$(gh api "repos/${repo}/compare/${base}...${head}" -q "$jq_filter" 2>/dev/null)"; then
    me="$my_login"
  else
    me="$(git config user.email)"
    commits="$(command git log --reverse --format='%h%x09%s%x09%ae' "${base}..${head}^")"
  fi

  echo "$commits" | while IFS=$'\t' read -r sha subject who; do
    if [ "$who" = "$me" ]; then
      printf '* %s (%s)\n' "$subject" "$sha"
    else
      printf '* %s (%s) - thanks @%s!\n' "$subject" "$sha" "$who"
    fi
  done
}

function git() {
  case "$1" in
    c|cs)        "git_$1" "${@:2}" ;;
    changelog)   git_changelog "${@:2}" ;;
    *)           command git "$@" ;;
  esac
}

function git-stats() {
set -euo pipefail

# Usage:
#   bash git-lines-by-month-stream.sh
#   bash git-lines-by-month-stream.sh /path/repo
#   bash git-lines-by-month-stream.sh --all
#   bash git-lines-by-month-stream.sh /path/repo --all

REPO="."
REV="HEAD"

if [[ "${1:-}" == "--all" ]]; then
  REV="--all"
elif [[ -n "${1:-}" ]]; then
  REPO="$1"
  if [[ "${2:-}" == "--all" ]]; then
    REV="--all"
  fi
fi

cd "$REPO"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: not a git repo: $REPO" >&2
  exit 1
fi

# Colors (TTY only)
GREEN="" RED="" RESET=""
if [[ -t 1 ]]; then
  GREEN=$'\033[32m'
  RED=$'\033[31m'
  RESET=$'\033[0m'
fi

# Column widths
W_MONTH=3
W_COMMITS=7
W_LINES=9
W_V1=6
W_V2=6
W_TREND=7
MONTHS=18
RECENT_WINDOW=3
NORM_WINDOW=12
CHART_PADDING=2
CHART_HEIGHT=$((MONTHS - 1 - CHART_PADDING))

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/git-stats/v4"
# Generated, vendored and lock files, left out of line counts
EXCLUDE=(
  ':(exclude,glob)**/build/**' ':(exclude,glob)**/dist/**' ':(exclude,glob)**/out/**'
  ':(exclude,glob)**/.next/**' ':(exclude,glob)**/node_modules/**' ':(exclude,glob)**/vendor/**'
  ':(exclude,glob)**/coverage/**' ':(exclude,glob)**/generated/**' ':(exclude,glob)**/__generated__/**'
  ':(exclude,glob)**/prisma/client/**'
  ':(exclude,glob)**/*.min.js' ':(exclude,glob)**/*.min.css' ':(exclude,glob)**/*.map'
  ':(exclude,glob)**/*.snap' ':(exclude,glob)**/*.gen.*'
  ':(exclude,glob)**/package-lock.json' ':(exclude,glob)**/pnpm-lock.yaml' ':(exclude,glob)**/yarn.lock'
  ':(exclude,glob)**/bun.lock' ':(exclude,glob)**/bun.lockb' ':(exclude,glob)**/composer.lock'
  ':(exclude,glob)**/Gemfile.lock' ':(exclude,glob)**/Cargo.lock' ':(exclude,glob)**/poetry.lock'
  ':(exclude,glob)**/go.sum'
)
MONTH_NAMES=(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)
N=$((MONTHS + RECENT_WINDOW - 1 + NORM_WINDOW))

read -r year month day < <(date "+%Y %-m %-d")

# DESCENDING order: current month → MONTHS-1 months ago, plus older months
# that only feed the trend baseline. days[i] is the days elapsed in month i.
months=() labels=() days=() commits=() shas=() added=() deleted=()
for ((i = 0; i < N; i++)); do
  ym=$((year * 12 + month - 1 - i))
  y=$((ym / 12)) m=$((ym % 12 + 1))
  printf -v "months[i]" "%04d-%02d" $y $m
  labels[i]=${MONTH_NAMES[m - 1]}
  case $m in
    2) days[i]=$(( y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) ? 29 : 28 )) ;;
    4|6|9|11) days[i]=30 ;;
    *) days[i]=31 ;;
  esac
  commits[i]=0 shas[i]="" added[i]=0 deleted[i]=0
done
# length is the calendar length. days[0] becomes days elapsed, for the projection.
length=("${days[@]}")
days[0]=$day
ym=$((year * 12 + month))
printf -v next_month "%04d-%02d-01 00:00:00" $((ym / 12)) $((ym % 12 + 1))

while read -r ym sha; do
  i=$(( year * 12 + month - 10#${ym#*-} - ${ym%-*} * 12 ))
  commits[i]=$((commits[i] + 1))
  shas[i]+="$sha"$'\n'
done < <(git log $REV --since="${months[N - 1]}-01 00:00:00" --before="$next_month" \
  --date=format-local:%Y-%m --pretty=tformat:'%cd %H')

# Line counts are cached per month, keyed by the hash of its commit list and
# the exclude list, and missing months are diffed in parallel.
mkdir -p "$CACHE_DIR"
keys=()
for ((i = 0; i < MONTHS; i++)); do
  (( commits[i] > 0 )) || continue
  keys[i]="$(printf '%s\n' "${shas[i]}" "${EXCLUDE[@]}" | git hash-object --stdin)"
  cache="$CACHE_DIR/${keys[i]}"
  [[ -f "$cache" ]] && continue
  (
    printf '%s' "${shas[i]}" \
    | git log --no-walk=unsorted --stdin --numstat --no-renames --pretty=tformat: -- . "${EXCLUDE[@]}" \
    | awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { a += $1; d += $2 }
           END { printf "%d %d\n", a, d }' >"$cache.$$" \
    && mv "$cache.$$" "$cache"
  ) &
done
wait

for ((i = 0; i < MONTHS; i++)); do
  (( commits[i] > 0 )) || continue
  read -r "added[i]" "deleted[i]" <"$CACHE_DIR/${keys[i]}"
done

# Table on the left, commits bar chart (oldest month first) on the right
table=()
widths=("$W_MONTH" "$W_COMMITS" "$W_LINES" "$W_LINES" "$W_V1" "$W_V2" "$W_TREND")
top="┌" mid="├" bottom="└"
for ((c = 0; c < ${#widths[@]}; c++)); do
  printf -v seg "%*s" $((widths[c] + 2)) ""
  seg=${seg// /─}
  if (( c < ${#widths[@]} - 1 )); then
    top+="$seg┬" mid+="$seg┼" bottom+="$seg┴"
  else
    top+="$seg┐" mid+="$seg┤" bottom+="$seg┘"
  fi
done

printf -v header "│ %-*s │ %*s │ %*s │ %*s │ %*s │ %*s │ %*s │" \
  "$W_MONTH" "MON" \
  "$W_COMMITS" "COMMITS" \
  "$W_LINES" "+LINES" \
  "$W_LINES" "-LINES" \
  "$W_V1" "V1" \
  "$W_V2" "V2" \
  "$W_TREND" "TREND"
table+=("$top" "$header" "$mid")

# V2: pace projected onto an average-length month (30.44 days).
# V1: that projection divided by the calendar length of the month.
# For the current month, the projection uses the days elapsed so far.
# TREND uses the unrounded daily rate: average of the last RECENT_WINDOW
# months vs the median of the NORM_WINDOW months before them.
velocity=()
for ((i = 0; i < N; i++)); do
  velocity[i]=$(( (commits[i] * 10 * 2 + days[i]) / (2 * days[i]) ))
done

for ((i = 0; i < MONTHS; i++)); do
  monthly=$(( (commits[i] * 3044 * 2 / 10 + days[i]) / (2 * days[i]) ))
  v2=$(( (monthly + 5) / 10 ))
  v1=$(( (v2 * 2 + length[i]) / (2 * length[i]) ))

  recent=0
  for ((j = i; j < i + RECENT_WINDOW; j++)); do recent=$((recent + velocity[j])); done
  sorted=($(printf '%s\n' "${velocity[@]:i+RECENT_WINDOW:NORM_WINDOW}" | sort -n))
  # twice the median, so even-sized windows stay in integer math
  median2=$(( sorted[(NORM_WINDOW - 1) / 2] + sorted[NORM_WINDOW / 2] ))

  color=""
  if (( median2 == 0 )); then
    if (( recent > 0 )); then trend="new"; else trend="-"; fi
  else
    num=$((recent * 2 * 100)) den=$((median2 * RECENT_WINDOW))
    pct=$(( (2 * num + den) / (2 * den) - 100 ))
    if (( pct > 0 )); then trend="+${pct}%" color=$GREEN
    elif (( pct < 0 )); then trend="${pct}%" color=$RED
    else trend="0%"
    fi
  fi

  printf -v row "│ %-*s │ %*d │ %s%*d%s │ %s%*d%s │ %*d │ %*d │ %s%*s%s │" \
    "$W_MONTH" "${labels[i]}" \
    "$W_COMMITS" "${commits[i]}" \
    "$GREEN" "$W_LINES" "${added[i]}" "$RESET" \
    "$RED"   "$W_LINES" "${deleted[i]}" "$RESET" \
    "$W_V1" "$v1" \
    "$W_V2" "$v2" \
    "$color" "$W_TREND" "$trend" "$RESET"
  table+=("$row")
done

max=1
for ((i = 0; i < MONTHS; i++)); do if (( commits[i] > max )); then max=${commits[i]}; fi; done

ctop="┌" cmid="├" cbottom="└"
for ((i = 0; i < MONTHS; i++)); do
  if (( i < MONTHS - 1 )); then
    ctop+="──────" cmid+="─────┬" cbottom+="─────┴"
  else
    ctop+="─────┐" cmid+="─────┤" cbottom+="─────┘"
  fi
done

chart=("$ctop")
printf -v blank "│%*s│" $((MONTHS * 6 - 1)) ""
for ((i = 0; i < CHART_PADDING; i++)); do chart+=("$blank"); done
for ((row = CHART_HEIGHT + 1; row >= 1; row--)); do
  line="│"
  for ((i = MONTHS - 1; i >= 0; i--)); do
    if (( i > 0 )); then sep=" "; else sep="│"; fi
    h=$(( (commits[i] * CHART_HEIGHT + max - 1) / max ))
    if (( h >= row )); then
      line+=" ${GREEN}███${RESET} $sep"
    elif (( h == row - 1 )); then
      printf -v cell "%4d %s" "${commits[i]}" "$sep"
      line+=$cell
    else
      line+="     $sep"
    fi
  done
  chart+=("$line")
done
line="│"
for ((i = MONTHS - 1; i >= 0; i--)); do
  line+=" ${labels[i]} │"
done
chart+=("$cmid" "$line" "$cbottom")

table+=("$bottom")

for ((i = 0; i < ${#chart[@]}; i++)); do
  echo "${table[i]} ${chart[i]}"
done

}
